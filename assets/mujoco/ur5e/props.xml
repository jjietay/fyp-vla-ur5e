<mujoco model="props">
  <!--
    Graspable props for Architecture A/B: four coloured cubes + a target bin.
    Included by scene_gripper.xml at the <mujoco> top level (NOT inside <worldbody>),
    so its <asset> and <worldbody> sections merge into the parent scene.

    IMPORTANT: each block carries a <freejoint>, adding 7 qpos to the model. The
    home keyframe in scene_gripper.xml must list these 7 values per block (pos xyz +
    quat wxyz) in the SAME ORDER the blocks appear below, appended AFTER the existing
    arm+gripper qpos. The bin is static (no joint) and adds no qpos.

    Frame: table top is at world z = 0; a 40 mm cube (half-size 0.02) rests with its
    centre at z = 0.02 (0.021 used for a hair of clearance). Arm base is at the origin.
  -->

  <asset>
    <material name="mat_block_red"    rgba="0.85 0.15 0.15 1"/>
    <material name="mat_block_green"  rgba="0.15 0.70 0.20 1"/>
    <material name="mat_block_blue"   rgba="0.15 0.35 0.85 1"/>
    <material name="mat_block_yellow" rgba="0.90 0.80 0.10 1"/>
    <material name="mat_bin"          rgba="0.30 0.30 0.33 1"/>
  </asset>

  <worldbody>
    <!-- Order here defines qpos order in the keyframe: red, green, blue, yellow. -->
    <body name="block_red" pos="0.45 0.20 0.021">
      <freejoint name="block_red_joint"/>
      <geom name="block_red_geom" type="box" size="0.02 0.02 0.02"
            material="mat_block_red" mass="0.05" condim="4"
            friction="1.0 0.02 0.001"/>
    </body>

    <body name="block_green" pos="0.45 0.00 0.021">
      <freejoint name="block_green_joint"/>
      <geom name="block_green_geom" type="box" size="0.02 0.02 0.02"
            material="mat_block_green" mass="0.05" condim="4"
            friction="1.0 0.02 0.001"/>
    </body>

    <body name="block_blue" pos="0.45 -0.20 0.021">
      <freejoint name="block_blue_joint"/>
      <geom name="block_blue_geom" type="box" size="0.02 0.02 0.02"
            material="mat_block_blue" mass="0.05" condim="4"
            friction="1.0 0.02 0.001"/>
    </body>

    <body name="block_yellow" pos="0.58 0.10 0.021">
      <freejoint name="block_yellow_joint"/>
      <geom name="block_yellow_geom" type="box" size="0.02 0.02 0.02"
            material="mat_block_yellow" mass="0.05" condim="4"
            friction="1.0 0.02 0.001"/>
    </body>

    <!-- Static target bin (shallow open tray). No joint -> contributes no qpos. -->
    <body name="bin" pos="0.50 -0.40 0.0">
      <geom name="bin_floor"   type="box" size="0.09  0.09  0.005" pos="0 0 0.005"    material="mat_bin"/>
      <geom name="bin_wall_px" type="box" size="0.005 0.09  0.03"  pos="0.085 0 0.03"  material="mat_bin"/>
      <geom name="bin_wall_nx" type="box" size="0.005 0.09  0.03"  pos="-0.085 0 0.03" material="mat_bin"/>
      <geom name="bin_wall_py" type="box" size="0.09  0.005 0.03"  pos="0 0.085 0.03"  material="mat_bin"/>
      <geom name="bin_wall_ny" type="box" size="0.09  0.005 0.03"  pos="0 -0.085 0.03" material="mat_bin"/>
    </body>
  </worldbody>
</mujoco>
